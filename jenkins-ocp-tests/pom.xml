<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.andrey5608</groupId>
        <artifactId>gatling-example</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jenkins-ocp-tests</artifactId>
    <packaging>jar</packaging>

    <name>jenkins-ocp-tests</name>
    <description>Jenkins + OpenShift execution plan and supporting assets.</description>

    <properties>
        <jenkins.ocp.image>artifactory.example.com/perf/gatling-runner:latest</jenkins.ocp.image>
        <jib.from.image>eclipse-temurin:17-jre</jib.from.image>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.andrey5608</groupId>
            <artifactId>gatling</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>io.gatling</groupId>
            <artifactId>gatling-app</artifactId>
            <version>${gatling.version}</version>
        </dependency>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.14</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <from>
                        <image>${jib.from.image}</image>
                    </from>
                    <to>
                        <image>${jenkins.ocp.image}</image>
                    </to>
                    <container>
                        <mainClass>org.andrey5608.jenkins.GatlingEntryPoint</mainClass>
                        <environment>
                            <SIMULATION_CLASS>org.andrey5608.performance.FastEndpointSimulation</SIMULATION_CLASS>
                        </environment>
                        <jvmFlags>
                            <jvmFlag>-Xms512m</jvmFlag>
                            <jvmFlag>-Xmx1024m</jvmFlag>
                        </jvmFlags>
                        <args>
                            <arg>--results-dir=/tmp/gatling-results</arg>
                        </args>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
